# Copy to .env and adjust.
DATABASE_URL="postgresql://hoymiles:hoymiles_dev@localhost:5433/hoymiles"
# DTU address - the collector rediscovers it by serial if it moves.
DTU_HOST="192.168.1.50"
DTU_SERIAL="4100ABCDEF01"
# 300000 (5 min) keeps the DTU's S-Miles cloud uplink alive; 30000 (30 s) starves it.
POLL_INTERVAL_MS=300000
PORT=3001
