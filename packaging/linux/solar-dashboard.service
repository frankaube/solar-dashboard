[Unit]
Description=Solar Dashboard - local solar, EV and home energy monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/solar-dashboard
ExecStart=/opt/solar-dashboard/solar-dashboard
Restart=on-failure
RestartSec=10
User=solar
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
