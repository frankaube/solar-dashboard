# Copy to `.env` and fill in. Devices are normally configured in the app
# (Settings -> Devices -> Scan network); these env values are fallbacks that let a
# fresh container come up already pointed at your hardware.
#
# Nothing here has a real default baked into docker-compose.yml — an install-specific
# address or a shared secret shipped in a public repo is worse than a missing value.

# --- Required if you run the TeslaMate service -------------------------------
# Encrypts your Tesla API tokens at rest. Generate: openssl rand -base64 24
# Compose refuses to start without it. Changing it later means re-authenticating.
#TESLAMATE_ENCRYPTION_KEY=

# --- Your hardware -----------------------------------------------------------
#DTU_HOST=192.168.1.50
#DTU_SERIAL=
#CHARGER_HOST=192.168.1.51

# --- Site location (weather forecast) ----------------------------------------
# Decimal degrees. Leave unset and the weather feature stays off rather than
# showing you someone else's forecast. Settable in the app instead.
#SITE_LATITUDE=45.4215
#SITE_LONGITUDE=-75.6972

# --- Everything else ---------------------------------------------------------
#POLL_INTERVAL_MS=300000
#NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-topic
#MQTT_URL=mqtt://homeassistant.local:1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#API_TOKEN=
#POSTGRES_PASSWORD=change_me

# Which calendar day a reading counts toward (IANA zone). Set this in Docker — a
# container has no timezone of its own, so unset means daily totals bucket by UTC.
#SITE_TIMEZONE=America/Toronto

# Where in-app backups are written on the host. A USB disk, a NAS mount, or any
# folder this machine can reach. Defaults to ./backups next to docker-compose.yml.
#BACKUP_DIR=/mnt/nas/solar-backups

# Bridge to a self-hosted evcc instance (https://evcc.io) for vehicles and chargers
# this app has no native adapter for: Audi, BMW, Ford, Hyundai, Kia, Nissan,
# Renault, Skoda, VW, Volvo and more, plus dozens of wallboxes.
#EVCC_URL=http://evcc.local:7070
# Optional: ingest evcc over MQTT rather than polling. Needs MQTT_URL as well.
#EVCC_MQTT_PREFIX=evcc

# OCPP 1.6J central system. Works with Wallbox, ABB Terra AC, Alfen, ABL, Zaptec and
# most other non-Tesla wallboxes. The charger dials out to us, so unlike every other
# integration here it needs no discovery and no open port on the charger.
#OCPP_ENABLE=1
#OCPP_PORT=9000

# go-e Charger on your LAN. Local HTTP API v2, no cloud account, no credentials.
#GOE_HOST=10.0.0.60

# OVMS dongle (openvehicles.com) publishing to your MQTT broker. The only vehicle
# source that works without a manufacturer cloud account. Needs MQTT_URL too.
#OVMS_MQTT_PREFIX=ovms
